
<div class="container mt-5">

  <!-- Website heading -->
  <div class="text-center mb-5">
    <h1>Welcome to BookNest 📚</h1>
    <p class="lead">
      Discover books from different authors and categories.
    </p>
  </div>


<!-- Search and category filtering form -->
<div class="card shadow-sm mb-4">
  <div class="card-body">

    <%= form_with url: books_path, method: :get, local: true do %>
      <div class="row g-3 align-items-end">

        <!-- Search books by title -->
        <div class="col-md-5">
          <%= label_tag :search, "Search Books",
                        class: "form-label" %>

          <%= text_field_tag :search,
                             params[:search],
                             class: "form-control",
                             placeholder: "Enter book title..." %>
        </div>

        <!-- Filter books by category -->
        <div class="col-md-4">
          <%= label_tag :category_id, "Category",
                        class: "form-label" %>

          <%= select_tag :category_id,
              options_from_collection_for_select(
                @categories,
                :id,
                :name,
                params[:category_id]
              ),
              include_blank: "All Categories",
              class: "form-select" %>
        </div>

        <!-- Search button -->
        <div class="col-md-2">
          <%= submit_tag "Search",
                         class: "btn btn-primary w-100" %>
        </div>

        <!-- Clear filters -->
        <div class="col-md-1">
          <%= link_to "Clear", books_path,
                      class: "btn btn-outline-secondary w-100" %>
        </div>

      </div>
    <% end %>

  </div>
</div>


<!-- Display a message when no books match the search -->
<% if @books.empty? %>
  <div class="alert alert-warning text-center mt-4">
    <h5>No books found!</h5>
    <p>
      Try another book title or select a different category.
    </p>
    <%= link_to "View All Books",
                books_path,
                class: "btn btn-primary" %>
  </div>
<% end %>


  <!-- Book catalogue -->
  <div class="mb-4">
    <h2>
      Our Book Collection
      (<%= @books.total_count %> Books)
    </h2>
  </div>

  <div class="row">
    <% @books.each do |book| %>
      <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">

            <h5 class="card-title">
              <%= book.title %>
            </h5>

            <p class="card-text">
              <strong>Author:</strong>
              <%= book.author.name %>
            </p>

            <p class="card-text">
              <strong>Category:</strong>
              <%= book.category.name %>
            </p>

            <p class="card-text">
              <strong>Price:</strong>
              <%= number_to_currency(book.price) %>
            </p>

            <%= link_to "View Details",
                        book_path(book),
                        class: "btn btn-primary" %>

          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Pagination navigation -->
<div class="d-flex justify-content-center mt-4 mb-5">
  <%= paginate @books,
      params: {
        search: params[:search],
        category_id: params[:category_id]
      } %>
</div>

</div>
